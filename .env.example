# Backend API URL (used by frontend in production)
# In development, Vite's proxy handles routing to localhost:3001
VITE_API_URL=

# LMStudio AI endpoint (used by the worker in Docker). Must be the OpenAI-compatible route:
# LMStudio's own /api/v1/chat rejects the "seed" parameter the evaluation sends.
LMSTUDIO_URL=http://192.168.0.18:1234/v1/chat/completions

# Service token for non-interactive callers (the model-evaluation notebook, other local
# programs). Leave it empty to turn that path off: then only a real login authenticates.
# Any long random string works, e.g. `openssl rand -hex 32`.
EVAL_API_TOKEN=

# Decoding used by the Worker when it calls the LLM. The defaults are greedy decoding, which is
# what makes an audit reproducible; the endpoint does not accept a seed. Changing these during a
# study invalidates the comparison between models.
AI_TEMPERATURE=0
AI_TOP_K=1
AI_TOP_P=1

# URL do Producer que o notebook de avaliação usa. O padrão (http://localhost:3002) é a stack
# isolada de docker-compose.evaluation.yml, com banco próprio e descartável. Só defina esta
# variável para apontar para outro Producer de avaliação; NÃO use a porta 3001 (banco real).
# EVAL_PRODUCER_URL=http://localhost:3002
